---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

type Crumb = { name: string; href: string };
type Props = {
  title: string;
  description: string;
  keywords?: string;
  crumbs?: Crumb[];
  schema?: Record<string, unknown>[];
  ogImage?: string;
};
const { title, description, keywords, crumbs = [], schema = [], ogImage = '/og.jpg', } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;

const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${SITE.url}/#business`,
  name: `${SITE.name} — ${SITE.brand}`,
  description: 'Прокат и аренда инвалидных колясок в Москве без залога, от 3 дней. Доставка, дезинфекция перед каждой выдачей.',
  url: SITE.url,
  telephone: SITE.phone,
  email: SITE.email,
  image: `${SITE.url}/img/chair-front.webp`,
  priceRange: 'от 200 ₽/день',
  areaServed: { '@type': 'City', name: 'Москва' },
  address: { '@type': 'PostalAddress', addressLocality: 'Москва', addressCountry: 'RU' },
  sameAs: [SITE.telegramBot],
};

const breadcrumbs = crumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Главная', href: '/' }, ...crumbs].map((c, i) => ({
        '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, SITE.url).href,
      })),
    }
  : null;
const ld = [business, ...(breadcrumbs ? [breadcrumbs] : []), ...schema];
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="theme-color" content="#0e1a36" />
  <meta name="geo.region" content="RU-MOW" />
  <meta name="geo.placename" content="Москва" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:site_name" content={SITE.brand} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(ogImage, SITE.url).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preload" as="image" href="/img/chair-front.webp" type="image/webp" />
  {ld.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  <!-- Яндекс.Метрика / VK Pixel: вставьте сюда код счётчиков со старого сайта -->
</head>
<body>
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2">К содержимому</a>
  <Header />
  <main id="main">
    {crumbs.length > 0 && (
      <nav aria-label="Хлебные крошки" class="container-x pt-28 text-sm text-muted">
        <ol class="flex flex-wrap items-center gap-1.5">
          <li><a href="/" class="hover:text-coral">Главная</a></li>
          {crumbs.map((c, i) => (
            <li class="flex items-center gap-1.5">
              <span aria-hidden="true">/</span>
              {i === crumbs.length - 1 ? <span aria-current="page" class="text-ink">{c.name}</span> : <a href={c.href} class="hover:text-coral">{c.name}</a>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <slot />
  </main>
  <Footer />

  <!-- Круглые кнопки связи -->
  <div class="fixed right-4 bottom-4 z-40 flex flex-col gap-3 md:right-6 md:bottom-6" data-fab>
    <a href={SITE.telegramBot} target="_blank" rel="noopener" class="fab grid size-14 place-items-center rounded-full bg-[#2aabee] text-white shadow-[0_12px_30px_-8px_rgb(42_171_238/.7)] transition-transform hover:scale-105 active:scale-95" aria-label="Написать в Telegram">
      <svg class="size-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.4 4.3 2.9 11.4c-1.3.5-1.2 1.2-.2 1.5l4.7 1.5 1.8 5.6c.2.6.4.8.9.8.4 0 .6-.2.9-.4l2.3-2.2 4.7 3.5c.9.5 1.5.2 1.7-.8l3.1-14.5c.3-1.3-.5-1.8-1.4-1.5zM9.6 14.4l-.4 4 -1.4-4.6L18.5 7z"/></svg>
    </a>
    <a href={SITE.phoneHref} class="fab fab-pulse relative grid size-14 place-items-center rounded-full bg-coral text-white shadow-[0_12px_30px_-8px_rgb(229_72_77/.8)] transition-transform hover:scale-105 active:scale-95" aria-label={`Позвонить ${SITE.phone}`}>
      <svg class="size-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>
    </a>
  </div>

  <!-- Cookie -->
  <div class="fixed left-3 right-20 bottom-3 z-[45] hidden md:right-auto md:bottom-6 md:left-6 md:max-w-md" data-cookie role="region" aria-label="Уведомление о cookie">
    <div class="flex items-center gap-3 rounded-2xl bg-ink p-3 pl-4 text-[13px] text-white/80 shadow-2xl">
      <p>Мы используем cookie. Оставаясь на сайте, вы соглашаетесь с <a href="/cookie/" class="font-semibold text-white underline underline-offset-2">политикой cookie</a>.</p>
      <button class="btn btn-primary shrink-0 !px-4 !py-2.5 !text-[13px]" data-cookie-ok>Ок</button>
    </div>
  </div>

  <script>
    import '../scripts/ui';
  </script>
</body>
</html>
