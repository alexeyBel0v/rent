---
import Icon from './Icon.astro';
import { cover, type Article } from '../data/articles';
type Props = { a: Article; index?: number; featured?: boolean };
const { a, index = 0, featured = false } = Astro.props;
const catColor: Record<Article['category'], string> = {
  'Выбор': 'bg-[#e3eaf7] text-[#2b4dbb]',
  'Инструкция': 'bg-[#ffe1df] text-coral-dark',
  'Советы': 'bg-[#d9f5ea] text-[#137a57]',
};
---
<a href={`/stati/${a.slug}/`} data-cat={a.category}
  class:list={['reveal group relative flex overflow-hidden rounded-[28px] bg-paper ring-1 ring-ink/[.06] transition-shadow duration-500 hover:shadow-[0_30px_60px_-30px_rgb(14_26_54/.45)]', featured ? 'flex-col lg:col-span-full lg:flex-row' : 'flex-col']}
  style={`--d:${(index % 3) * 90}ms`}>
  <div class:list={['relative overflow-hidden', featured ? 'aspect-[16/10] lg:aspect-auto lg:w-[58%]' : 'aspect-[16/10]']}>
    <img src={cover(a.slug)} alt={a.title} width="1200" height="750" loading={featured ? 'eager' : 'lazy'}
      class="h-full w-full object-cover transition-transform duration-[900ms] ease-[var(--ease-out-expo)] group-hover:scale-[1.06]" />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/35 via-transparent to-transparent" aria-hidden="true"></div>
    <span class:list={['absolute top-4 left-4 inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-[12px] font-bold shadow-sm', catColor[a.category]]}>{a.category}</span>
    <span class="absolute right-4 bottom-4 grid size-12 translate-y-2 place-items-center rounded-full bg-white text-ink opacity-0 shadow-lg transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100" aria-hidden="true"><Icon name="arrow" class="size-5" /></span>
  </div>
  <div class:list={['flex flex-1 flex-col', featured ? 'p-7 md:p-10 lg:justify-center' : 'p-6']}>
    <p class="text-[13px] font-semibold text-muted">{a.read} чтения</p>
    <h3 class:list={['mt-2 font-semibold transition-colors group-hover:text-coral', featured ? 'text-2xl md:text-[32px] md:leading-tight' : 'text-xl leading-snug']}>{a.title}</h3>
    <p class:list={['mt-3 text-muted', featured ? 'text-lg' : 'line-clamp-2 text-[15px]']}>{a.description}</p>
    <span class="mt-auto inline-flex items-center gap-2 pt-5 font-bold">Читать статью <Icon name="arrow" class="size-4 transition-transform group-hover:translate-x-1" /></span>
  </div>
</a>
