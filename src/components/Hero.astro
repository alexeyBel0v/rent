---
import Icon from './Icon.astro';
import { SITE, PRICES, CHAIRS, fmt } from '../data/site';
const showcase = CHAIRS;
---
<section class="relative isolate overflow-hidden bg-cream" data-hero>
  <!-- мягкий фон: сетка + пятна цвета -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute -top-32 right-[-10%] size-[640px] rounded-full bg-[#cfe0ff] opacity-70 blur-[120px]"></div>
    <div class="absolute bottom-[-25%] left-[-10%] size-[520px] rounded-full bg-[#ffd9d6] opacity-60 blur-[120px]"></div>
    <div class="absolute inset-0 opacity-[.5] [background-image:linear-gradient(rgb(14_26_54/.05)_1px,transparent_1px),linear-gradient(90deg,rgb(14_26_54/.05)_1px,transparent_1px)] [background-size:48px_48px] [mask-image:radial-gradient(ellipse_at_60%_30%,black,transparent_75%)]"></div>
  </div>

  <div class="container-x grid grid-cols-[minmax(0,1fr)] items-center gap-10 pt-28 pb-16 lg:min-h-[100svh] lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:pt-28 lg:pb-14">
    <div>
      <p class="hero-in inline-flex items-center gap-2.5 rounded-full bg-white py-1.5 pr-4 pl-1.5 text-[13px] font-bold shadow-sm ring-1 ring-ink/5" style="--d:0ms">
        <span class="flex h-5 w-7 flex-col overflow-hidden rounded-[4px]" aria-hidden="true"><i class="flex-1 bg-[#111]"></i><i class="flex-1 bg-[#dd0000]"></i><i class="flex-1 bg-[#ffce00]"></i></span>
        Немецкие Ottobock и Meyra в наличии
      </p>
      <h1 class="hero-in mt-6 text-[32px] leading-[1.08] font-semibold sm:text-[46px] lg:text-[52px]" style="--d:80ms">
        Аренда <span class="text-coral">немецких</span> инвалидных колясок в&nbsp;Москве
      </h1>
      <p class="hero-in mt-6 max-w-[540px] text-[17px] leading-relaxed text-muted md:text-lg" style="--d:160ms">
        Без залога, от {PRICES.minDays} дней. Чистая коляска после дезинфекции — заберите сами бесплатно или привезём курьером. Не подойдёт — заменим бесплатно.
      </p>

      <div class="hero-in mt-8 flex flex-col gap-3 sm:flex-row" style="--d:240ms">
        <a href="#podbor" class="btn btn-primary !px-8 !py-4.5 text-base">Подобрать коляску <Icon name="arrow" class="size-5" /></a>
        <a href={SITE.phoneHref} class="btn bg-white !py-4.5 text-base text-ink shadow-sm ring-1 ring-ink/10 hover:bg-paper"><Icon name="phone" class="size-5 text-coral" />{SITE.phone}</a>
      </div>

      <dl class="hero-in mt-10 grid max-w-[540px] grid-cols-3 gap-3" style="--d:320ms">
        <div class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-ink/5"><dt class="text-[12px] text-muted">Залог</dt><dd class="font-display text-xl font-semibold whitespace-nowrap sm:text-2xl">0 ₽</dd></div>
        <div class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-ink/5"><dt class="text-[12px] text-muted">{PRICES.minDays} дня</dt><dd class="font-display text-xl font-semibold whitespace-nowrap sm:text-2xl">{fmt(PRICES.minPrice)}</dd></div>
        <div class="rounded-2xl bg-ink p-4 text-white shadow-sm"><dt class="text-[12px] text-white/60">от месяца</dt><dd class="font-display text-xl font-semibold whitespace-nowrap sm:text-2xl">{PRICES.monthPerDay} ₽<span class="text-sm text-white/60">/д</span></dd></div>
      </dl>
    </div>

    <!-- витрина колясок -->
    <div class="hero-in relative" style="--d:200ms" data-showcase>
      <div class="relative overflow-hidden rounded-[36px] bg-white p-5 shadow-[0_40px_80px_-40px_rgb(14_26_54/.45)] ring-1 ring-ink/5 md:p-7">
        <div class="flex gap-1.5 overflow-x-auto rounded-full bg-cream p-1.5 [scrollbar-width:none]" role="tablist" aria-label="Модели колясок">
          {showcase.map((c, i) => (
            <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-sc-tab={i}
              class="flex-1 rounded-full px-3 py-2 text-[14px] font-bold whitespace-nowrap text-muted transition-all aria-selected:bg-ink aria-selected:text-white aria-selected:shadow">{c.short}</button>
          ))}
        </div>

        <div class="relative mt-4 aspect-[5/4]">
          {showcase.map((c, i) => (
            <a href={`/katalog/${c.slug}/`} class:list={['sc-slide absolute inset-0 flex items-center justify-center', i === 0 && 'is-active']} data-sc-slide={i} aria-label={c.name} tabindex={i === 0 ? 0 : -1}>
              {c.photo
                ? <img src={c.images[0]!.src} alt={c.images[0]!.alt} width="800" height="685" loading={i ? 'lazy' : 'eager'} class="h-full w-full rounded-3xl object-cover" />
                : <img src={c.images[0]!.src} alt={c.images[0]!.alt} width="600" height="600" loading={i ? 'lazy' : 'eager'} fetchpriority={i ? 'low' : 'high'} class="h-[96%] w-auto object-contain" />}
              {c.german && <span class="absolute top-2 left-2 flex items-center gap-1.5 rounded-full bg-ink px-3 py-1.5 text-[12px] font-bold text-white"><span class="flex h-3 w-4 flex-col overflow-hidden rounded-[2px]"><i class="flex-1 bg-[#111]"></i><i class="flex-1 bg-[#dd0000]"></i><i class="flex-1 bg-[#ffce00]"></i></span>Германия</span>}
            </a>
          ))}
        </div>

        <div class="mt-4 flex items-end justify-between gap-4 border-t border-ink/5 pt-4">
          <div class="min-w-0">
            {showcase.map((c, i) => (
              <div class:list={['sc-info', i !== 0 && 'hidden']} data-sc-info={i}>
                <p class="font-display text-xl font-semibold md:text-2xl">{c.name}</p>
                <p class="mt-1 truncate text-[14px] text-muted">{c.tagline}</p>
              </div>
            ))}
          </div>
          <div class="shrink-0 text-right">
            <p class="text-[12px] text-muted">от</p>
            <p class="font-display text-2xl font-semibold">{PRICES.monthPerDay} ₽<span class="text-sm text-muted">/день</span></p>
          </div>
        </div>
      </div>

      <div class="floaty absolute -top-4 -right-2 hidden items-center gap-2 rounded-2xl bg-white px-4 py-3 shadow-xl ring-1 ring-ink/5 sm:flex">
        <span class="grid size-9 place-items-center rounded-xl bg-mint/15 text-[#137a57]"><Icon name="sparkle" class="size-5" /></span>
        <span class="text-[13px] leading-tight font-bold">Дезинфекция<br/><span class="font-medium text-muted">перед каждой выдачей</span></span>
      </div>
      <div class="floaty absolute -bottom-5 -left-3 hidden items-center gap-2 rounded-2xl bg-white px-4 py-3 shadow-xl ring-1 ring-ink/5 sm:flex" style="animation-delay:-3s">
        <span class="flex text-coral">{[1, 2, 3, 4, 5].map(() => <Icon name="star" class="size-4" />)}</span>
        <span class="text-[13px] font-bold">Нас рекомендуют</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-in { opacity: 0; transform: translateY(24px); animation: heroIn 1s var(--ease-out-expo) forwards; animation-delay: var(--d); }
  @keyframes heroIn { to { opacity: 1; transform: none; } }
  .sc-slide { opacity: 0; transform: translateX(30px) scale(.96); pointer-events: none; transition: opacity .5s, transform .7s var(--ease-out-expo); }
  .sc-slide.is-active { opacity: 1; transform: none; pointer-events: auto; }
  @media (prefers-reduced-motion: reduce) { .hero-in { animation: none; opacity: 1; transform: none; } .sc-slide { transition: none; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-showcase]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-sc-tab]')];
    const slides = [...root.querySelectorAll<HTMLElement>('[data-sc-slide]')];
    const infos = [...root.querySelectorAll<HTMLElement>('[data-sc-info]')];
    let idx = 0; let timer: number | undefined;
    const show = (n: number) => {
      idx = (n + slides.length) % slides.length;
      tabs.forEach((t, i) => t.setAttribute('aria-selected', String(i === idx)));
      slides.forEach((s, i) => { s.classList.toggle('is-active', i === idx); s.tabIndex = i === idx ? 0 : -1; });
      infos.forEach((s, i) => s.classList.toggle('hidden', i !== idx));
    };
    const auto = () => {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      clearInterval(timer); timer = window.setInterval(() => show(idx + 1), 4500);
    };
    tabs.forEach((t, i) => t.addEventListener('click', () => { show(i); clearInterval(timer); }));
    root.addEventListener('pointerenter', () => clearInterval(timer));
    auto();
  }
</script>
