---
import Icon from './Icon.astro';
import { SITE } from '../data/site';
---
<section class="pb-20 md:pb-28">
  <div class="container-x">
    <div class="reveal relative overflow-hidden rounded-[36px] bg-coral px-6 py-12 text-white md:px-14 md:py-16">
      <img src="/img/chair-side.webp" alt="" width="642" height="571" loading="lazy" class="pointer-events-none absolute -right-10 -bottom-10 hidden w-[420px] opacity-95 drop-shadow-[0_30px_30px_rgba(0,0,0,.35)] md:block lg:right-10" />
      <div class="relative max-w-xl">
        <h2 class="h2">Нужна коляска сегодня?</h2>
        <p class="mt-4 text-lg text-white/85">Позвоните или напишите — подберём кресло и согласуем время доставки или самовывоза.</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={SITE.phoneHref} class="btn bg-white !py-4 text-ink hover:bg-cream"><Icon name="phone" class="size-5" />{SITE.phone}</a>
                    <a href={SITE.telegramBot} target="_blank" rel="noopener" class="btn btn-ghost !py-4"><Icon name="tg" class="size-5" />Telegram</a>
        </div>
      </div>
    </div>
  </div>
</section>
