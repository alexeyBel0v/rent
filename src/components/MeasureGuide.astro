---
// Памятка: какие замеры нужны для подбора коляски (только ширина бёдер, двери и лифт)
type Props = { compact?: boolean };
const { compact = false } = Astro.props;
const steps = [
  { k: 'A', title: 'Ширина бёдер', how: 'Человек садится на твёрдую поверхность — жёсткий стул или табурет. Приставьте к бёдрам с двух сторон по книге и измерьте расстояние между книгами.', rule: 'Ничего не прибавляйте — запас у коляски уже есть' },
  { k: 'B', title: 'Самая узкая дверь', how: 'Обычно это ванная или туалет. Меряйте между косяками в самом узком месте.', rule: 'Скажите нам цифру — проверим, пройдёт ли коляска' },
  { k: 'C', title: 'Дверь лифта', how: 'Так же — между створками в самом узком месте. Если лифта нет или первый этаж, этот замер не нужен.', rule: 'Если лифт узкий — подберём модель' },
];
---
<div class:list={['grid gap-6', compact ? 'lg:grid-cols-[1fr_1.1fr]' : 'lg:grid-cols-[1fr_1.15fr]']}>
  <div class="reveal card relative self-start overflow-hidden p-6 md:p-8 lg:sticky lg:top-28">
    <svg viewBox="0 0 520 360" class="w-full" role="img" aria-label="Схема: A — ширина бёдер между двумя книгами, B — ширина двери">
      <defs>
        <marker id="ar" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#e5484d"/></marker>
      </defs>
      <!-- человек на стуле, вид спереди, с книгами -->
      <text x="150" y="24" text-anchor="middle" font-size="14" font-weight="700" fill="#5d6886">Ширина бёдер</text>
      <circle cx="150" cy="70" r="24" fill="#13204a"/>
      <rect x="112" y="100" width="76" height="92" rx="26" fill="#13204a"/>
      <rect x="92" y="186" width="116" height="40" rx="18" fill="#2b4dbb"/>
      <rect x="102" y="222" width="34" height="92" rx="14" fill="#13204a"/>
      <rect x="164" y="222" width="34" height="92" rx="14" fill="#13204a"/>
      <rect x="74" y="226" width="152" height="12" rx="4" fill="#c9d3e8"/>
      <rect x="84" y="238" width="10" height="80" fill="#c9d3e8"/><rect x="206" y="238" width="10" height="80" fill="#c9d3e8"/>
      <!-- книги -->
      <rect x="66" y="160" width="24" height="66" rx="3" fill="#e5484d"/><rect x="70" y="166" width="16" height="4" fill="#fff" opacity=".6"/>
      <rect x="210" y="160" width="24" height="66" rx="3" fill="#e5484d"/><rect x="214" y="166" width="16" height="4" fill="#fff" opacity=".6"/>
      <line x1="92" y1="146" x2="208" y2="146" stroke="#e5484d" stroke-width="3" marker-start="url(#ar)" marker-end="url(#ar)"/>
      <circle cx="150" cy="132" r="14" fill="#e5484d"/><text x="150" y="137" text-anchor="middle" font-size="14" font-weight="800" fill="#fff">A</text>
      <line x1="40" y1="330" x2="260" y2="330" stroke="#c9d3e8" stroke-width="3"/>

      <!-- дверь -->
      <text x="400" y="24" text-anchor="middle" font-size="14" font-weight="700" fill="#5d6886">Дверь и лифт</text>
      <rect x="322" y="50" width="16" height="280" fill="#13204a"/>
      <rect x="462" y="50" width="16" height="280" fill="#13204a"/>
      <rect x="322" y="40" width="156" height="16" fill="#13204a"/>
      <rect x="338" y="56" width="124" height="274" fill="#e3eaf7"/>
      <line x1="342" y1="200" x2="458" y2="200" stroke="#e5484d" stroke-width="3" marker-start="url(#ar)" marker-end="url(#ar)"/>
      <circle cx="400" cy="184" r="14" fill="#e5484d"/><text x="400" y="189" text-anchor="middle" font-size="14" font-weight="800" fill="#fff">B</text>
      <line x1="300" y1="330" x2="500" y2="330" stroke="#c9d3e8" stroke-width="3"/>
    </svg>
    <p class="mt-4 rounded-2xl bg-cream px-4 py-3 text-[14px] text-muted">Понадобятся рулетка и две книги. Остальное подберём по росту и весу — больше ничего мерить не нужно.</p>
  </div>

  <ol class="grid content-start gap-3">
    {steps.map((s, i) => (
      <li class="reveal card flex gap-4 p-5 md:p-6" style={`--d:${i * 70}ms`}>
        <span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-coral font-display font-semibold text-white">{s.k}</span>
        <div>
          <p class="text-lg font-bold">{s.title}</p>
          <p class="mt-1 text-[15px] text-muted">{s.how}</p>
          <p class="mt-2 inline-block rounded-full bg-mist px-3 py-1 text-[13px] font-bold">{s.rule}</p>
        </div>
      </li>
    ))}
  </ol>
</div>
