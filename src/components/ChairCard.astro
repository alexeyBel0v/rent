---
import Icon from './Icon.astro';
import ChairArt from './ChairArt.astro';
import { PRICES, type Chair } from '../data/site';
type Props = { chair: Chair; index?: number };
const { chair, index = 0 } = Astro.props;
const img = chair.images[0];
---
<article class="reveal" style={`--d:${index * 120}ms`}>
  <a href={`/katalog/${chair.slug}/`} class="tilt card group relative block overflow-hidden p-6 md:p-8" data-tilt="8">
    <div class="relative flex aspect-[4/3] items-center justify-center rounded-[22px] bg-gradient-to-br from-mist to-white">
      <div class="absolute inset-0 rounded-[22px] opacity-60 [background-image:radial-gradient(circle_at_center,rgb(14_26_54/.08)_1px,transparent_1px)] [background-size:18px_18px]"></div>
      {chair.badge && <span class="pop absolute top-4 left-4 z-10 rounded-full bg-ink px-3 py-1.5 text-[12px] font-bold text-white">{chair.badge}</span>}
      {img
        ? <img src={img.src} alt={img.alt} width="648" height="600" loading="lazy" class="pop relative h-[86%] w-auto object-contain drop-shadow-[0_30px_25px_rgba(14,26,54,.28)] transition-transform duration-700 group-hover:scale-[1.04]" />
        : <ChairArt class="pop relative h-[78%] w-auto text-ink" />}
    </div>
    <div class="mt-6 flex items-start justify-between gap-4">
      <div>
        <p class="text-[13px] font-bold tracking-wide text-coral uppercase">{chair.brand}</p>
        <h3 class="mt-1 text-2xl font-semibold">{chair.name}</h3>
        <p class="mt-2 text-[15px] text-muted">{chair.tagline}</p>
      </div>
    </div>
    <ul class="mt-5 space-y-2">
      {chair.features.slice(0, 3).map((f) => <li class="flex gap-2 text-[15px]"><Icon name="check" class="mt-0.5 size-5 shrink-0 text-mint" />{f}</li>)}
    </ul>
    <div class="mt-7 flex items-center justify-between border-t border-ink/10 pt-5">
      <p class="text-[15px]"><span class="text-muted">от </span><b class="font-display text-2xl font-semibold">{PRICES.monthPerDay} ₽</b><span class="text-muted"> / день</span></p>
      <span class="flex size-12 items-center justify-center rounded-full bg-ink text-white transition-transform duration-500 group-hover:translate-x-1 group-hover:bg-coral">
        <Icon name="arrow" class="size-5" />
      </span>
    </div>
    <span class="glare"></span>
  </a>
</article>
