---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import { ARTICLES } from '../../data/articles';
---
<Base title="Статьи и инструкции по инвалидным коляскам" description="Как выбрать и измерить коляску, сложить и разложить, заехать на бордюр, пересадить человека, перевозить в машине. Инструкции и советы от проката колясок в Москве." crumbs={[{ name: 'Статьи', href: '/stati/' }]}>
  <PageHead eyebrow="Статьи" title="Инструкции и советы" lead="Как выбрать, измерить и безопасно пользоваться инвалидной коляской — коротко и по делу." />
  <section class="container-x grid gap-6 pb-20 md:grid-cols-2 lg:grid-cols-3">
    {ARTICLES.map((a, i) => (
      <a href={`/stati/${a.slug}/`} class="reveal tilt card group relative block p-8" style={`--d:${i * 100}ms`} data-tilt="6">
        <p class="pop text-[13px] font-bold text-coral uppercase">{a.category} · {a.read}</p>
        <h2 class="pop mt-3 text-2xl font-semibold">{a.title}</h2>
        <p class="mt-3 text-muted">{a.description}</p>
        <span class="mt-6 inline-flex items-center gap-2 font-bold">Читать <Icon name="arrow" class="size-5 transition-transform group-hover:translate-x-1" /></span>
        <span class="glare"></span>
      </a>
    ))}
  </section>
</Base>
