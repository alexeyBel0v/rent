---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Icon from '../../components/Icon.astro';
import { ARTICLES } from '../../data/articles';
import { SITE } from '../../data/site';
const featured = ARTICLES.find((a) => a.slug === 'kak-izmerit-cheloveka-dlya-kolyaski') ?? ARTICLES[0]!;
const rest = ARTICLES.filter((a) => a !== featured);
const cats = ['Все', 'Инструкция', 'Выбор', 'Советы'] as const;
const list = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  itemListElement: ARTICLES.map((a, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}/stati/${a.slug}/`, name: a.title })),
};
---
<Base title="Статьи и инструкции по инвалидным коляскам" description="Как выбрать и измерить коляску, сложить и разложить, заехать на бордюр, пересадить человека, перевозить в машине. Инструкции и советы от проката колясок в Москве." crumbs={[{ name: 'Статьи', href: '/stati/' }]} schema={[list]}>
  <header class="container-x pt-8 pb-10 md:pt-12">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <span class="eyebrow">Журнал</span>
        <h1 class="mt-4 text-[34px] leading-[1.06] font-semibold md:text-[56px]">Инструкции и советы</h1>
        <p class="mt-4 max-w-xl text-lg text-muted">Как выбрать, измерить и безопасно пользоваться инвалидной коляской — коротко и по делу.</p>
      </div>
      <div class="flex flex-wrap gap-2" role="toolbar" aria-label="Фильтр по рубрикам" data-filters>
        {cats.map((c, i) => (
          <button type="button" data-filter={c} aria-pressed={i === 0 ? 'true' : 'false'}
            class="rounded-full bg-white px-4 py-2.5 text-[14px] font-bold shadow-sm ring-1 ring-ink/5 transition-colors aria-pressed:bg-ink aria-pressed:text-white">{c}</button>
        ))}
      </div>
    </div>
  </header>

  <section class="container-x pb-20">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-grid>
      <ArticleCard a={featured} featured />
      {rest.map((a, i) => <ArticleCard a={a} index={i} />)}
    </div>
    <div class="reveal mt-10 flex flex-col items-start gap-4 rounded-[28px] bg-ink p-7 text-white md:flex-row md:items-center md:justify-between md:p-9">
      <div>
        <p class="font-display text-2xl font-semibold">Остались вопросы?</p>
        <p class="mt-1 text-white/70">Позвоните — подскажем по выбору и использованию коляски бесплатно.</p>
      </div>
      <a href={SITE.phoneHref} class="btn btn-primary"><Icon name="phone" class="size-5" />{SITE.phone}</a>
    </div>
  </section>
</Base>

<script>
  const btns = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-grid] [data-cat]')];
  btns.forEach((b) => b.addEventListener('click', () => {
    const f = b.dataset.filter;
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    cards.forEach((c) => { c.hidden = f !== 'Все' && c.dataset.cat !== f; });
  }));
</script>
