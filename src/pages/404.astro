---
import Base from '../layouts/Base.astro';
---
<Base title="Страница не найдена" description="Такой страницы нет. Перейдите на главную страницу проката инвалидных колясок.">
  <section class="container-x grid min-h-[70vh] place-items-center pt-28 text-center">
    <div>
      <p class="font-display text-[120px] leading-none font-semibold text-coral">404</p>
      <h1 class="mt-4 text-3xl font-semibold">Такой страницы нет</h1>
      <a href="/" class="btn btn-primary mt-8">На главную</a>
    </div>
  </section>
</Base>
