---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Sections from '../components/Sections.astro';
import Quiz from '../components/Quiz.astro';
import Cta from '../components/Cta.astro';
import { SITE } from '../data/site';
---
<Base
  title="Доставка инвалидной коляски по Москве — самовывоз бесплатно"
  description={`Доставка и возврат инвалидной коляски по Москве через Яндекс.Доставку. Время доставки: ${SITE.deliveryHours}. Самовывоз — бесплатно.`}
  keywords="доставка инвалидной коляски москва, аренда инвалидной коляски с доставкой, привезти инвалидную коляску на дом"
  crumbs={[{ name: 'Доставка', href: '/dostavka/' }]}
>
  <PageHead eyebrow="Доставка и возврат" title="Привезём коляску к двери или заберёте сами" lead="Отправляем и забираем кресло курьером — не нужно никуда ехать, особенно когда человек только после больницы." />
  <section class="container-x prose-rwc max-w-3xl pb-4">
    <h2>Самовывоз</h2>
    <p>Бесплатно. При получении сотрудник покажет, как раскладывать и складывать кресло, пользоваться тормозами и подножками.</p>
    <h2>Доставка курьером</h2>
    <p>Доставляем и забираем кресло через Яндекс.Доставку. Стоимость доставки и возврата рассчитывается по тарифам сервиса и оплачивается клиентом — назовём сумму заранее, при звонке.</p>
    <ul>
      <li>Время доставки: {SITE.deliveryHours}</li>
      <li>Коляска приезжает чистой, после ТО и дезинфекции</li>
      <li>Если кресло не подошло — бесплатно заменим</li>
    </ul>
    <h2>Возврат и продление</h2>
    <p>За день до окончания срока напишите или позвоните: договоримся о возврате или продлим аренду без лишних визитов.</p>
  </section>
  <Sections only={['steps']} />
  <Quiz />
  <Cta />
</Base>
