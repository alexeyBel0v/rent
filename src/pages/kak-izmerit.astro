---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import MeasureGuide from '../components/MeasureGuide.astro';
import Quiz from '../components/Quiz.astro';
import Cta from '../components/Cta.astro';
import { SITE } from '../data/site';
const howto = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Как снять мерки человека для подбора инвалидной коляски',
  totalTime: 'PT5M',
  tool: [{ '@type': 'HowToTool', name: 'Рулетка' }],
  step: [
    { '@type': 'HowToStep', name: 'Ширина бёдер', text: 'Сидя на жёстком стуле измерьте ширину бёдер в самом широком месте. Ширина сиденья коляски = замер + 2–5 см.' },
    { '@type': 'HowToStep', name: 'Глубина сиденья', text: 'Измерьте расстояние от спины до подколенной ямки. Глубина сиденья = замер − 4–5 см.' },
    { '@type': 'HowToStep', name: 'Высота спинки', text: 'Измерьте от сиденья до нижнего угла лопатки или до подмышки.' },
    { '@type': 'HowToStep', name: 'Длина голени', text: 'Измерьте от подколенной ямки до пола в обуви.' },
    { '@type': 'HowToStep', name: 'Двери и лифт', text: 'Измерьте самую узкую дверь дома и дверь лифта. Коляска шире сиденья примерно на 18–20 см.' },
  ],
  publisher: { '@id': `${SITE.url}/#business` },
};
---
<Base
  title="Как измерить человека для инвалидной коляски — памятка с замерами"
  description="Как подобрать размер инвалидной коляски: ширина бёдер, глубина сиденья, высота спинки, длина голени, ширина дверей и лифта. Простая памятка со схемой — 5 минут и рулетка."
  keywords="как измерить для инвалидной коляски, размер инвалидной коляски, ширина сиденья инвалидной коляски, как подобрать инвалидную коляску по размеру"
  crumbs={[{ name: 'Как измерить', href: '/kak-izmerit/' }]}
  schema={[howto]}
>
  <PageHead eyebrow="Памятка" title="Как снять мерки для инвалидной коляски" lead="Пять замеров — и коляска подойдёт с первого раза: будет удобно сидеть, она пройдёт в двери и в лифт." />
  <section class="container-x pb-6"><MeasureGuide /></section>
  <section class="container-x prose-rwc max-w-3xl py-10">
    <h2>Почему это важно</h2>
    <p>Слишком узкое сиденье давит на бёдра, слишком широкое — заставляет тянуться к колёсам и заваливаться на бок. Слишком глубокое сиденье упирается под колени, слишком короткое — не даёт опоры бёдрам. Пять минут с рулеткой избавят от неудобств на всё время аренды.</p>
    <h2>Не хотите мерить сами?</h2>
    <p>Назовите рост и вес — этого обычно хватает, чтобы подобрать стандартную модель. А если коляска всё же не подойдёт, мы бесплатно заменим её на другую.</p>
  </section>
  <Quiz />
  <Cta />
</Base>
