---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import MeasureGuide from '../components/MeasureGuide.astro';
import Quiz from '../components/Quiz.astro';
import Cta from '../components/Cta.astro';
import { SITE } from '../data/site';
const howto = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Как измерить ширину бёдер и дверей для подбора инвалидной коляски',
  totalTime: 'PT3M',
  tool: [{ '@type': 'HowToTool', name: 'Рулетка' }, { '@type': 'HowToTool', name: 'Две книги' }],
  step: [
    { '@type': 'HowToStep', name: 'Ширина бёдер', text: 'Посадите человека на твёрдую поверхность, приставьте к бёдрам с двух сторон по книге и измерьте расстояние между книгами.' },
    { '@type': 'HowToStep', name: 'Ширина двери', text: 'Измерьте самую узкую дверь в квартире между косяками.' },
    { '@type': 'HowToStep', name: 'Ширина лифта', text: 'Измерьте дверь лифта в самом узком месте.' },
  ],
  publisher: { '@id': `${SITE.url}/#business` },
};
---
<Base
  title="Как измерить человека для инвалидной коляски — ширина бёдер, двери, лифт"
  description="Как подобрать размер инвалидной коляски: простой способ измерить ширину бёдер с помощью двух книг, ширину дверей и лифта. Памятка со схемой."
  keywords="как измерить для инвалидной коляски, размер инвалидной коляски, ширина сиденья инвалидной коляски, как подобрать инвалидную коляску по размеру"
  crumbs={[{ name: 'Как измерить', href: '/kak-izmerit/' }]}
  schema={[howto]}
>
  <PageHead eyebrow="Памятка" title="Как измерить человека для инвалидной коляски" lead="Нужны всего три цифры: ширина бёдер, самой узкой двери и лифта. Остальное подберём по росту и весу." />
  <section class="container-x pb-6"><MeasureGuide /></section>
  <section class="container-x prose-rwc max-w-3xl py-10">
    <h2>Почему важна ширина бёдер</h2>
    <p>От неё зависит ширина сиденья. В слишком узкой коляске сидеть тесно, в слишком широкой — человек заваливается на бок и тянется к колёсам. Способ с книгами даёт точную цифру — нам этого достаточно, запас у коляски уже предусмотрен.</p>
    <h2>А рост и вес?</h2>
    <p>Их просто назовите при заявке — по ним мы подберём модель и настроим подножки при выдаче. Больше ничего мерить не нужно.</p>
  </section>
  <Quiz />
  <Cta />
</Base>
