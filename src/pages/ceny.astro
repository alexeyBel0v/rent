---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Calculator from '../components/Calculator.astro';
import Quiz from '../components/Quiz.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { PRICES, SITE, CHAIRS, calcPrice, fmt } from '../data/site';

const tariffs = [
  {
    name: '3 дня',
    term: 'минимальный срок',
    price: fmt(PRICES.minPrice),
    per: `≈ ${Math.round(PRICES.minPrice / PRICES.minDays)} ₽ в день`,
    note: 'Выписка, поездка, визит к врачу',
    for: 'Когда коляска нужна на пару дней',
    accent: false,
  },
  {
    name: 'Месяц',
    term: `${PRICES.monthDays} дней`,
    price: fmt(PRICES.monthPrice),
    per: `${PRICES.monthPerDay} ₽ в день`,
    note: `Дольше месяца — ${PRICES.monthPerDay} ₽ за каждый день`,
    for: 'Реабилитация после операции или перелома',
    accent: true,
  },
  {
    name: 'Неделя',
    term: `${PRICES.weekDays} дней`,
    price: fmt(PRICES.weekPrice),
    per: `${Math.round(PRICES.weekPrice / PRICES.weekDays)} ₽ в день`,
    note: `Дольше недели — +${PRICES.perDay} ₽ за день`,
    for: 'Восстановление после травмы, приезд родственников',
    accent: false,
  },
];
const included = [
  { icon: 'shield', t: 'Без залога', d: 'Никаких замороженных денег' },
  { icon: 'sparkle', t: 'ТО и дезинфекция', d: 'Перед каждой выдачей' },
  { icon: 'check', t: 'Фиксированная цена', d: 'Одна на все модели' },
  { icon: 'calendar', t: 'Продление', d: 'По звонку, без визитов' },
  { icon: 'user', t: 'Инструктаж', d: 'Покажем, как пользоваться' },
  { icon: 'gift', t: 'День заказа', d: 'В подарок' },
];
const terms = [3, 7, 14, 21, 30, 60];
const label = (d: number) => (d === 3 ? '3 дня' : d === 7 ? 'Неделя' : d === 14 ? '2 недели' : d === 21 ? '3 недели' : d === 30 ? 'Месяц' : '2 месяца');
const maxPer = calcPrice(3) / 3;
const offers = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Тарифы на аренду инвалидных колясок',
  itemListElement: terms.map((d) => ({ '@type': 'Offer', name: `Аренда инвалидной коляски — ${label(d)}`, price: calcPrice(d), priceCurrency: 'RUB', areaServed: 'Москва' })),
};
---
<Base
  title="Цены на аренду инвалидной коляски в Москве — от 170 ₽ в день, без залога"
  description={`Стоимость аренды инвалидной коляски в Москве: ${PRICES.minDays} дня — ${fmt(PRICES.minPrice)}, неделя — ${fmt(PRICES.weekPrice)}, месяц — ${fmt(PRICES.monthPrice)}. Фиксированные цены, без залога. Калькулятор онлайн.`}
  keywords="аренда инвалидной коляски цена, сколько стоит аренда инвалидной коляски, прокат инвалидной коляски стоимость, инвалидная коляска посуточно, аренда коляски на месяц цена"
  crumbs={[{ name: 'Цены', href: '/ceny/' }]}
  schema={[offers]}
>
  <!-- шапка -->
  <header class="container-x pt-8 pb-12 md:pt-12">
    <div class="grid items-end gap-8 lg:grid-cols-[1.3fr_1fr]">
      <div>
        <span class="eyebrow">Цены</span>
        <h1 class="mt-4 text-[34px] leading-[1.06] font-semibold md:text-[60px]">Чем дольше —<br/><span class="text-coral">тем дешевле</span> день</h1>
        <p class="mt-5 max-w-xl text-lg text-muted md:text-xl">Цены фиксированные и одинаковые для всех моделей — и для немецких Ottobock и Meyra, и для Ortonica и Флагман. Без залога и скрытых платежей.</p>
      </div>
      <div class="flex items-center gap-4 rounded-[28px] bg-white p-5 shadow-sm ring-1 ring-ink/5">
        <div class="flex -space-x-6">
          {CHAIRS.slice(0, 3).map((c) => <span class="grid size-16 place-items-center overflow-hidden rounded-2xl bg-gradient-to-br from-mist to-white ring-4 ring-white"><img src={c.images[0]!.src} alt="" class="h-[90%] w-auto object-contain" /></span>)}
        </div>
        <p class="text-[15px] leading-snug"><b class="block text-lg">Все модели — одна цена</b><span class="text-muted">Выбирайте по удобству, а не по бюджету</span></p>
      </div>
    </div>
  </header>

  <!-- тарифы -->
  <section class="container-x">
    <div class="grid gap-5 lg:grid-cols-3 lg:items-center">
      {tariffs.map((t, i) => (
        <article class:list={['reveal tilt relative flex flex-col overflow-hidden rounded-[32px] p-7 md:p-9', t.accent ? 'order-first bg-ink text-white shadow-[0_40px_80px_-30px_rgb(14_26_54/.6)] lg:order-none lg:py-12' : 'card']} style={`--d:${i * 100}ms`} data-tilt="6">
          {t.accent && <>
            <div class="pointer-events-none absolute -top-24 -right-24 size-64 rounded-full bg-coral/40 blur-3xl" aria-hidden="true"></div>
            <span class="pop absolute top-6 right-6 rounded-full bg-coral px-3 py-1.5 text-[12px] font-bold">Выгоднее всего</span>
          </>}
          <p class:list={['pop text-[14px] font-bold tracking-wide uppercase', t.accent ? 'text-sky' : 'text-coral']}>{t.name}</p>
          <p class:list={['mt-1 text-[15px]', t.accent ? 'text-white/60' : 'text-muted']}>{t.term}</p>
          <p class="pop mt-6 font-display text-5xl font-semibold md:text-6xl">{t.price}</p>
          <p class:list={['mt-1 text-lg', t.accent ? 'text-white/70' : 'text-muted']}>{t.per}</p>
          <p class:list={['mt-5 inline-flex w-fit rounded-full px-3 py-1.5 text-[14px] font-bold', t.accent ? 'bg-white/10' : 'bg-mist']}>{t.note}</p>
          <p class:list={['mt-6 border-t pt-5 text-[15px]', t.accent ? 'border-white/10 text-white/75' : 'border-ink/10 text-muted']}>Подходит: {t.for}</p>
          <a href="#podbor" class:list={['btn mt-7', t.accent ? 'btn-primary' : 'btn-dark']}>Забронировать <Icon name="arrow" class="size-5" /></a>
          <span class="glare"></span>
        </article>
      ))}
    </div>
  </section>

  <!-- сроки: визуальная шкала -->
  <section class="container-x py-20 md:py-24">
    <div class="reveal max-w-2xl">
      <span class="eyebrow">Примеры</span>
      <h2 class="h2 mt-4">Сколько выйдет за ваш срок</h2>
    </div>
    <div class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-6">
      {terms.map((d, i) => {
        const total = calcPrice(d); const per = Math.round(total / d);
        const best = d >= PRICES.monthDays;
        return (
          <div class:list={['reveal relative flex flex-col justify-between overflow-hidden rounded-[24px] p-5', best ? 'bg-coral text-white' : 'card']} style={`--d:${i * 60}ms`}>
            <p class:list={['text-[14px] font-bold', best ? 'text-white/85' : 'text-muted']}>{label(d)}</p>
            <p class="mt-3 font-display text-2xl font-semibold whitespace-nowrap">{fmt(total)}</p>
            <div class="mt-5">
              <div class:list={['h-2 overflow-hidden rounded-full', best ? 'bg-white/25' : 'bg-mist']}>
                <div class:list={['h-full rounded-full', best ? 'bg-white' : 'bg-ink']} style={`width:${Math.round((per / maxPer) * 100)}%`}></div>
              </div>
              <p class:list={['mt-2 text-[13px]', best ? 'text-white/85' : 'text-muted']}>≈ {per} ₽ в день</p>
            </div>
          </div>
        );
      })}
    </div>
    <p class="mt-4 text-[14px] text-muted">Полоска — цена одного дня. Промежуточные сроки: 4–7 дней — как неделя; 8–29 дней — неделя + {PRICES.perDay} ₽ за каждый день, но не дороже месяца; от 30 дней — {PRICES.monthPerDay} ₽ в день.</p>
  </section>

  <!-- что входит -->
  <section class="bg-paper py-20 md:py-24">
    <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.6fr]">
      <div class="reveal">
        <span class="eyebrow">Включено в цену</span>
        <h2 class="h2 mt-4">Платите один раз — остальное наша забота</h2>
        <div class="mt-8 rounded-[24px] bg-cream p-6 ring-1 ring-ink/5">
          <p class="flex items-center gap-2 font-bold"><Icon name="truck" class="size-5 text-coral" />Оплачивается отдельно</p>
          <p class="mt-2 text-[15px] text-muted">Только курьерская доставка — по тарифам Яндекс.Доставки. Называем сумму заранее. Самовывоз — бесплатно. <a href="/dostavka/" class="font-semibold text-coral underline underline-offset-2">Подробнее о доставке</a></p>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-3 md:grid-cols-3">
        {included.map((x, i) => (
          <div class="reveal card p-6" style={`--d:${(i % 3) * 80}ms`}>
            <span class="grid size-12 place-items-center rounded-2xl bg-mist text-coral"><Icon name={x.icon} class="size-6" /></span>
            <p class="mt-5 text-lg font-bold">{x.t}</p>
            <p class="mt-1 text-[14px] text-muted">{x.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Calculator simple />
  <Quiz />
  <Faq limit={4} title="Вопросы об оплате и сроках" />
  <Cta />
</Base>
