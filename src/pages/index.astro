---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ChairCard from '../components/ChairCard.astro';
import Calculator from '../components/Calculator.astro';
import Sections from '../components/Sections.astro';
import Quiz from '../components/Quiz.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import Icon from '../components/Icon.astro';
import MeasureGuide from '../components/MeasureGuide.astro';
import { ARTICLES } from '../data/articles';
import { CHAIRS, FAQ, PRICES, SITE } from '../data/site';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const offerSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Прокат инвалидных колясок',
  provider: { '@id': `${SITE.url}/#business` },
  areaServed: 'Москва',
  offers: [
    { '@type': 'Offer', name: `Аренда на ${PRICES.minDays} дня`, price: PRICES.minPrice, priceCurrency: 'RUB' },
    { '@type': 'Offer', name: 'Аренда на 30 дней', price: PRICES.monthDays * PRICES.monthPerDay, priceCurrency: 'RUB' },
  ],
};
const ticker = ['Без залога', 'Дезинфекция перед каждой выдачей', 'Аренда от 3 дней', 'Ремонт за наш счёт', 'Бесплатная замена', 'Самовывоз бесплатно', 'Немецкие Ottobock и Meyra', 'Подбор по размерам'];
---
<Base
  title="Аренда немецких инвалидных колясок Ottobock и Meyra в Москве — без залога, от 200 ₽/день"
  description="Прокат немецких инвалидных колясок Ottobock и Meyra в Москве: без залога, от 3 дней, от 200 ₽ в день. Дезинфекция перед каждой выдачей, бесплатная замена, самовывоз бесплатно, доставка курьером. ☎ +7 968 808-89-88"
  keywords="аренда инвалидной коляски, аренда коляски ottobock, прокат коляски meyra, немецкая инвалидная коляска напрокат, прокат инвалидных колясок москва, инвалидное кресло напрокат, коляска инвалидная аренда без залога, взять инвалидную коляску в аренду"
  schema={[faqSchema, offerSchema]}

>
  <Hero />

  <div class="overflow-hidden border-y border-ink/5 bg-paper py-5" aria-hidden="true">
    <div class="marquee flex w-max gap-10 font-display text-lg font-semibold whitespace-nowrap text-ink/80">
      {[...ticker, ...ticker].map((t) => <span class="flex items-center gap-10">{t}<span class="text-coral">✦</span></span>)}
    </div>
  </div>

  <section class="py-20 md:py-28" id="katalog">
    <div class="container-x">
      <div class="reveal flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div class="max-w-2xl">
          <span class="eyebrow">Каталог</span>
          <h2 class="h2 mt-4">Немецкие коляски — и не только</h2>
          <p class="mt-4 text-lg text-muted">Ottobock и Meyra из Германии — основа нашего парка. Для коротких сроков и экономного бюджета есть Ortonica и Флагман.</p>
        </div>
        <a href="/katalog/" class="inline-flex items-center gap-2 font-bold text-coral hover:underline">Весь каталог <Icon name="arrow" class="size-5" /></a>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {CHAIRS.map((c, i) => <ChairCard chair={c} index={i} />)}
      </div>
      <div class="reveal mt-6 flex flex-col items-start gap-4 rounded-[28px] bg-ink-2 p-6 text-white md:flex-row md:items-center md:justify-between md:p-8">
        <div class="flex items-center gap-4">
          <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-coral font-display text-lg font-semibold">%</span>
          <div>
            <p class="text-lg font-bold">Распродажа кресел Ottobock</p>
            <p class="text-white/65">Хотите не арендовать, а купить? Расскажем, какие кресла есть в наличии.</p>
          </div>
        </div>
        <a href={SITE.phoneHref} class="btn bg-white text-ink hover:bg-cream">Узнать подробнее</a>
      </div>
    </div>
  </section>

  <Calculator />
  <Sections only={['benefits', 'steps']} />
  <Quiz />
  <section class="py-20 md:py-28" id="zamery">
    <div class="container-x">
      <div class="reveal flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div class="max-w-2xl">
          <span class="eyebrow">Памятка</span>
          <h2 class="h2 mt-4">Как снять мерки, чтобы коляска подошла с первого раза</h2>
        </div>
        <a href="/kak-izmerit/" class="inline-flex items-center gap-2 font-bold text-coral hover:underline">Подробнее <Icon name="arrow" class="size-5" /></a>
      </div>
      <div class="mt-12"><MeasureGuide compact /></div>
    </div>
  </section>
  <Sections only={['delivery', 'reviews']} />
  <section class="py-20 md:py-28" id="stati">
    <div class="container-x">
      <div class="reveal flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div class="max-w-2xl">
          <span class="eyebrow">Инструкции</span>
          <h2 class="h2 mt-4">Как пользоваться коляской: просто о важном</h2>
        </div>
        <a href="/stati/" class="inline-flex items-center gap-2 font-bold text-coral hover:underline">Все статьи <Icon name="arrow" class="size-5" /></a>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {ARTICLES.filter((a) => a.category === 'Инструкция').slice(0, 3).concat(ARTICLES.filter((a) => a.slug === 'ottobock-ili-meyra' || a.slug === 'kolyaska-posle-operacii' || a.slug === 'kak-perevozit-kolyasku-v-mashine')).map((a, i) => (
          <a href={`/stati/${a.slug}/`} class="reveal tilt card group relative flex flex-col p-7" style={`--d:${(i % 3) * 90}ms`} data-tilt="6">
            <span class="pop inline-flex w-fit items-center gap-1.5 rounded-full bg-mist px-3 py-1 text-[12px] font-bold text-coral"><Icon name="book" class="size-3.5" />{a.category} · {a.read}</span>
            <h3 class="pop mt-4 text-lg leading-snug font-semibold">{a.title}</h3>
            <p class="mt-2 line-clamp-2 text-[15px] text-muted">{a.description}</p>
            <span class="mt-auto inline-flex items-center gap-2 pt-5 font-bold">Читать <Icon name="arrow" class="size-4 transition-transform group-hover:translate-x-1" /></span>
            <span class="glare"></span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <Faq limit={6} />

  <section class="pb-16">
    <div class="container-x">
      <div class="reveal prose-rwc max-w-3xl">
        <h2>Прокат инвалидных колясок в Москве</h2>
        <p>Инвалидная коляска часто нужна на время: после операции или перелома, на период реабилитации, для поездки с пожилым родственником или на выписку из больницы. Покупать дорогое кресло ради нескольких недель невыгодно — проще взять коляску в аренду.</p>
        <p>Основа нашего парка — немецкие коляски Ottobock Старт и Meyra Eurochair²: надёжные, удобные, проверенные годами. Для коротких сроков есть облегчённая Ortonica и прочная Флагман. <a href="/ceny/">Аренда</a> — от {PRICES.minDays} дней и без залога, а при сроке от месяца день обходится всего в {PRICES.monthPerDay} ₽. Перед каждой выдачей кресло проходит техническое обслуживание и дезинфекцию. Забрать коляску можно самостоятельно или заказать <a href="/dostavka/">доставку по Москве</a>.</p>
        <p>Не знаете, какая модель подойдёт? Ответьте на 4 вопроса в форме подбора — мы учтём вес и рост человека, ширину дверей и лифта. Почитайте также, <a href="/stati/kak-vybrat-invalidnuyu-kolyasku/">как выбрать инвалидную коляску</a>.</p>
      </div>
    </div>
  </section>

  <Cta />
</Base>
