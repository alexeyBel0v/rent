---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ChairCard from '../components/ChairCard.astro';
import Calculator from '../components/Calculator.astro';
import Sections from '../components/Sections.astro';
import Quiz from '../components/Quiz.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import Icon from '../components/Icon.astro';
import MeasureGuide from '../components/MeasureGuide.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { ARTICLES } from '../data/articles';
import { CHAIRS, FAQ, PRICES, SITE } from '../data/site';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const offerSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Прокат инвалидных колясок',
  provider: { '@id': `${SITE.url}/#business` },
  areaServed: 'Москва',
  offers: [
    { '@type': 'Offer', name: `Аренда на ${PRICES.minDays} дня`, price: PRICES.minPrice, priceCurrency: 'RUB' },
    { '@type': 'Offer', name: 'Аренда на неделю', price: PRICES.weekPrice, priceCurrency: 'RUB' },
    { '@type': 'Offer', name: 'Аренда на 30 дней', price: PRICES.monthPrice, priceCurrency: 'RUB' },
  ],
};
const ticker = ['Без залога', 'Дезинфекция перед каждой выдачей', 'Аренда от 3 дней', 'Фиксированные цены', 'Инструктаж при выдаче', 'Самовывоз бесплатно', 'Ottobock и Meyra из Германии', 'Подбор по размерам'];
---
<Base
  title="Аренда инвалидных колясок в Москве — прокат без залога, от 170 ₽/день"
  description="Аренда и прокат инвалидных колясок в Москве: Ottobock, Meyra, Ortonica, Флагман. Без залога, от 3 дней, от 170 ₽ в день. Фиксированные цены, дезинфекция перед каждой выдачей, самовывоз бесплатно, доставка курьером. ☎ +7 968 808-89-88"
  keywords="аренда инвалидной коляски, аренда инвалидных колясок, прокат инвалидных колясок, аренда инвалидного кресла, инвалидное кресло напрокат, кресло-коляска в аренду, инвалидная коляска напрокат, аренда коляски ottobock, прокат коляски meyra, прокат инвалидных колясок москва, инвалидное кресло напрокат, коляска инвалидная аренда без залога, взять инвалидную коляску в аренду"
  schema={[faqSchema, offerSchema]}

>
  <Hero />

  <div class="overflow-hidden border-y border-ink/5 bg-paper py-5" aria-hidden="true">
    <div class="marquee flex w-max gap-10 font-display text-lg font-semibold whitespace-nowrap text-ink/80">
      {[...ticker, ...ticker].map((t) => <span class="flex items-center gap-10">{t}<span class="text-coral">✦</span></span>)}
    </div>
  </div>

  <section class="py-20 md:py-28" id="katalog">
    <div class="container-x">
      <div class="reveal flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div class="max-w-2xl">
          <span class="eyebrow">Каталог</span>
          <h2 class="h2 mt-4">Инвалидные коляски напрокат</h2>
          <p class="mt-4 text-lg text-muted">Немецкие Ottobock и Meyra, облегчённая Ortonica и прочная Флагман. Цены фиксированные — одинаковые для всех моделей.</p>
        </div>
        <a href="/katalog/" class="inline-flex items-center gap-2 font-bold text-coral hover:underline">Весь каталог <Icon name="arrow" class="size-5" /></a>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {CHAIRS.map((c, i) => <ChairCard chair={c} index={i} />)}
      </div>
    </div>
  </section>

  <Calculator />
  <Sections only={['benefits', 'steps']} />
  <Quiz />
  <section class="py-20 md:py-28" id="zamery">
    <div class="container-x">
      <div class="reveal flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div class="max-w-2xl">
          <span class="eyebrow">Памятка</span>
          <h2 class="h2 mt-4">Как измерить, чтобы коляска подошла</h2>
        </div>
        <a href="/kak-izmerit/" class="inline-flex items-center gap-2 font-bold text-coral hover:underline">Подробнее <Icon name="arrow" class="size-5" /></a>
      </div>
      <div class="mt-12"><MeasureGuide compact /></div>
    </div>
  </section>
  <Sections only={['delivery', 'reviews']} />
  <section class="py-20 md:py-28" id="stati">
    <div class="container-x">
      <div class="reveal flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div class="max-w-2xl">
          <span class="eyebrow">Инструкции</span>
          <h2 class="h2 mt-4">Как пользоваться коляской: просто о важном</h2>
        </div>
        <a href="/stati/" class="inline-flex items-center gap-2 font-bold text-coral hover:underline">Все статьи <Icon name="arrow" class="size-5" /></a>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {['kak-izmerit-cheloveka-dlya-kolyaski', 'kak-preodolet-bordyur-i-stupeni', 'ottobock-ili-meyra'].map((slug, i) => <ArticleCard a={ARTICLES.find((x) => x.slug === slug)!} index={i} />)}
      </div>
    </div>
  </section>
  <Faq limit={6} />

  <section class="pb-16">
    <div class="container-x">
      <div class="reveal prose-rwc max-w-3xl">
        <h2>Аренда и прокат инвалидных колясок в Москве</h2>
        <p>Инвалидная коляска часто нужна на время: после операции или перелома, на период реабилитации, для поездки с пожилым родственником или на выписку из больницы. Покупать кресло ради нескольких недель невыгодно — проще взять инвалидную коляску напрокат.</p>
        <p>У нас можно арендовать инвалидное кресло на любой срок от {PRICES.minDays} дней — без залога, по фиксированной цене. В прокате есть кресла-коляски Ottobock Старт и Meyra Eurochair² из Германии, облегчённая Ortonica и прочная Флагман. <a href="/ceny/">Стоимость аренды</a> одинаковая для всех моделей, а при сроке от месяца день обходится всего в {PRICES.monthPerDay} ₽.</p>
        <p>Перед каждой выдачей кресло проходит техническое обслуживание и дезинфекцию. Забрать коляску можно самостоятельно или заказать <a href="/dostavka/">доставку по Москве</a>. Чтобы подобрать размер, измерьте ширину бёдер и дверей — смотрите <a href="/kak-izmerit/">памятку</a>.</p>
      </div>
    </div>
  </section>

  <Cta />
</Base>
